@* SNMP credentials for one scope: a site's own (SiteId set) or the global ones shared by every site (SiteId null).
   On a site, the global credentials are listed read-only underneath because that site's checks can use them too. *@
@inject NmsApiClient Api

<section class="card">
    <h3>SNMP credentials</h3>
    <p class="small">
        @(SiteId is null
            ? "Shared by every site. Put a credential here only when the same community or SNMPv3 user is set on devices everywhere; otherwise add it on the site's settings page."
            : "Used only by this site's SNMP checks.")
        Communities and passwords are write-only: they go to the agents that poll with them and are never shown again. Leave a secret blank when editing to keep it. Prefer SNMPv3 with SHA-256 and AES where the device offers it.
    </p>
    <table class="grid">
        <thead><tr><th>Name</th><th>Version</th><th>User</th><th>Auth / privacy</th><th>Checks</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in own)
        {
            <tr><td>@c.Name</td><td>@(c.Version == SnmpVersion.V2c ? "v2c" : "v3")</td>
                <td>@c.User</td><td>@(c.Version == SnmpVersion.V3 ? $"{c.Auth} / {c.Priv}" : "community")</td><td>@c.Checks</td>
                <td class="actions">@if (isAdmin)
                    {
                        <button class="small" @onclick="() => Edit(c)">Edit</button>
                        <button class="danger small" @onclick="() => Delete(c.Id)" disabled="@(c.Checks > 0)" title="@(c.Checks > 0 ? "In use by SNMP checks" : "")">Delete</button>
                    }</td></tr>
        }
        @foreach (var c in inherited)
        {
            <tr class="muted"><td>@c.Name</td><td>@(c.Version == SnmpVersion.V2c ? "v2c" : "v3")</td>
                <td>@c.User</td><td>@(c.Version == SnmpVersion.V3 ? $"{c.Auth} / {c.Priv}" : "community")</td><td>@c.Checks</td>
                <td class="small">all sites · <a href="settings">edit in app settings</a></td></tr>
        }
        @if (own.Count == 0 && inherited.Count == 0) { <tr><td colspan="6" class="muted small">None yet.</td></tr> }
        </tbody>
    </table>
    @if (isAdmin)
    {
        <div class="form-row">
            <input placeholder="Name" @bind="f.Name" />
            <select @bind="f.Version"><option value="@SnmpVersion.V2c">SNMPv2c</option><option value="@SnmpVersion.V3">SNMPv3</option></select>
            @if (f.Version == SnmpVersion.V2c)
            {
                <input type="password" placeholder="@(f.EditingId is null ? "community" : "community (blank = keep)")" @bind="f.Community" autocomplete="new-password" />
            }
            else
            {
                <input placeholder="user" @bind="f.User" />
                <select @bind="f.Auth">@foreach (var a in Enum.GetValues<SnmpAuth>()) { <option value="@a">auth @a</option> }</select>
                @if (f.Auth != SnmpAuth.None) { <input type="password" placeholder="@(f.EditingId is null ? "auth password" : "auth password (blank = keep)")" @bind="f.AuthPassword" autocomplete="new-password" /> }
                <select @bind="f.Priv">@foreach (var p in Enum.GetValues<SnmpPriv>()) { <option value="@p">privacy @p</option> }</select>
                @if (f.Priv != SnmpPriv.None) { <input type="password" placeholder="@(f.EditingId is null ? "privacy password" : "privacy password (blank = keep)")" @bind="f.PrivPassword" autocomplete="new-password" /> }
                <input placeholder="context (optional)" @bind="f.Context" style="width:10em" />
            }
            <button class="primary" @onclick="Save" disabled="@string.IsNullOrWhiteSpace(f.Name)">@(f.EditingId is null ? "Add credential" : "Save")</button>
            @if (f.EditingId is not null) { <button class="small" @onclick="() => f = new()">Cancel</button> }
        </div>
    }
    else
    {
        <p class="small muted">Only administrators can add or change credentials.</p>
    }
    @if (error is not null) { <p class="error">@error</p> }
</section>

@code {
    /// <summary>The site whose credentials are edited; null edits the global ones.</summary>
    [Parameter] public Guid? SiteId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? Auth { get; set; }

    private List<SnmpCredentialView> own = new(), inherited = new();
    private Form f = new();
    private bool isAdmin;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        isAdmin = Auth is not null && (await Auth).User.IsInRole("Nms.Admin");
        await Load();
    }

    private async Task Load()
    {
        // With a site id the API returns that site's credentials plus the global ones.
        var all = await Api.GetSnmpCredentialsAsync(SiteId);
        own = all.Where(c => c.SiteId == SiteId).ToList();
        inherited = SiteId is null ? new() : all.Where(c => c.SiteId is null).ToList();
    }

    private async Task Save()
    {
        error = null;
        try
        {
            var input = new SnmpCredentialInput(f.Name, f.Version, SiteId, Blank(f.Community), Blank(f.User), f.Auth, Blank(f.AuthPassword), f.Priv, Blank(f.PrivPassword), Blank(f.Context));
            if (f.EditingId is { } id) await Api.UpdateSnmpCredentialAsync(id, input); else await Api.CreateSnmpCredentialAsync(input);
            f = new();
            await Load();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void Edit(SnmpCredentialView c) => f = new Form { EditingId = c.Id, Name = c.Name, Version = c.Version, User = c.User, Auth = c.Auth, Priv = c.Priv, Context = c.Context };

    private async Task Delete(Guid id)
    {
        error = null;
        try { await Api.DeleteSnmpCredentialAsync(id); await Load(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private static string? Blank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private sealed class Form
    {
        public Guid? EditingId { get; set; } public string Name { get; set; } = ""; public SnmpVersion Version { get; set; } = SnmpVersion.V3;
        public string? Community { get; set; } public string? User { get; set; } public SnmpAuth Auth { get; set; } = SnmpAuth.Sha256; public string? AuthPassword { get; set; }
        public SnmpPriv Priv { get; set; } = SnmpPriv.Aes128; public string? PrivPassword { get; set; } public string? Context { get; set; }
    }
}
