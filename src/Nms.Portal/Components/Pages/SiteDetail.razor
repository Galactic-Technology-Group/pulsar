@page "/sites/{SiteId:guid}"
@inject NmsApiClient Api
@inject LiveUpdates Live
@implements IDisposable

@if (site is null) { <p class="muted">Loading…</p> }
else
{
    <PageTitle>@site.Name</PageTitle>
    <h1>@site.Name <small class="muted">@site.VlanMode @(site.Address is null ? "" : " · " + site.Address)</small></h1>
    <AuthorizeView Roles="Nms.Admin,Nms.Operator">
        <p class="small"><a href="sites/@SiteId/settings">Site settings</a> <span class="muted">· location, gateway check, SNMP credentials, alert rules, maintenance</span></p>
    </AuthorizeView>

    <section class="card">
        <h3>Agents</h3>
        <table class="grid">
            <thead><tr><th>Name</th><th>Status</th><th>Host</th><th>Version</th><th>Last seen</th><th>Interfaces</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in agents)
            {
                <tr>
                    <td>@a.Name</td>
                    <td><StateBadge Agent="a.Status" /></td>
                    <td>@a.Hostname</td>
                    <td>@a.Version @if (a.RollbackFromVersion is not null) { <span class="error small" title="@a.RollbackReason">rolled back from @a.RollbackFromVersion</span> }</td>
                    <td title="@a.LastSeenUtc">@Ago(a.LastSeenUtc)</td>
                    <td class="small">@string.Join(", ", a.Interfaces.Select(i => $"{i.Name}{(i.VlanId is null ? "" : $" (VLAN {i.VlanId})")} {i.Address}/{i.PrefixLength}"))</td>
                    <td class="actions">
                        <AuthorizeView Roles="Nms.Admin,Nms.Operator">
                            <button class="small" @onclick="() => Reissue(a.Id)">Re-issue token</button>
                            <button class="small" @onclick="() => OpenDiscovery(a)" disabled="@(a.Status != AgentStatus.Online)">Discover</button>
                        </AuthorizeView>
                        <AuthorizeView Roles="Nms.Admin">
                            <button class="danger small" @onclick="() => Revoke(a.Id)">Revoke</button>
                        </AuthorizeView>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <AuthorizeView Roles="Nms.Admin,Nms.Operator">
            <p class="small muted">New appliances show an enrollment code on their console; approve it under <a href="agents/pending">Pending agents</a>. The token below is for scripted installs only.</p>
            <div class="form-row">
                <input placeholder="New agent name" @bind="newAgentName" />
                <button class="primary" @onclick="CreateAgent" disabled="@string.IsNullOrWhiteSpace(newAgentName)">Add agent (token)</button>
            </div>
        </AuthorizeView>
        @if (token is not null)
        {
            <div class="token">
                <b>Enrollment token (shown once, valid 24 h):</b>
                <code>@token.EnrollmentToken</code>
                <p class="small">On the agent host: <code>sudo ./install.sh --api-url &lt;api-url&gt; --token @token.EnrollmentToken</code></p>
            </div>
        }
    </section>

    @if (discoveryAgent is not null)
    {
        <section class="card">
            <h3>Discovery via @discoveryAgent.Name</h3>
            <div class="form-row">
                <label>CIDR <input @bind="discoveryCidr" placeholder="10.20.0.0/24" /></label>
                <label>VLAN <input type="number" @bind="discoveryVlan" /></label>
                <button class="primary" @onclick="RunDiscovery" disabled="@discoveryRunning">@(discoveryRunning ? "Scanning…" : "Scan")</button>
                <button @onclick="() => discoveryAgent = null">Close</button>
            </div>
            @if (discovery is not null)
            {
                @if (discovery.Error is not null) { <p class="error">@discovery.Error</p> }
                <table class="grid">
                    <thead><tr><th>Address</th><th>Hostname</th><th>MAC</th><th>Latency</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var h in discovery.Hosts)
                    {
                        var byMac = h.MacAddress is null ? null : devices.FirstOrDefault(d => d.MacAddress == h.MacAddress);
                        var known = byMac is not null || devices.Any(d => d.Address == h.Address);
                        var moved = byMac is not null && byMac.Address != h.Address;
                        <tr>
                            <td>@h.Address @if (moved) { <span class="error small">(@byMac!.Name was @byMac.Address)</span> }</td><td>@(h.Hostname ?? "-") @if (h.HostnameSource is not null and not "dns") { <small class="muted">(@h.HostnameSource)</small> }</td><td>@h.MacAddress</td><td>@(h.LatencyMs is null ? "-" : h.LatencyMs + " ms")</td>
                            <td>@if (moved) { <button class="small" @onclick="() => MoveDevice(byMac!, h.Address)">Update address</button> } else if (known) { <span class="muted">monitored</span> } else { <button class="small" @onclick="() => AddDiscovered(h)">Monitor</button> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>
    }

    @if (gateway is not null)
    {
        var gc = gateway.Checks.FirstOrDefault(c => c.Type == CheckType.GatewayPing);
        <section class="card">
            <h3>Gateway <small class="muted">TCP reachability probed from Azure, outside the site</small></h3>
            <p>
                @if (string.IsNullOrEmpty(gateway.Address)) { <span class="muted">No public address set: the agent-offline alert cannot say whether the site's line is down.</span> }
                else if (gc is null) { <span class="muted">no gateway check</span> }
                else
                {
                    <StateBadge State="gc.State" />
                    <span>@gateway.Address @(gc.Port is null ? "(ICMP, needs Worker:GatewayIcmpEnabled)" : $"(tcp/{gc.Port})") @(gc.LastLatencyMs is null ? "" : $"{gc.LastLatencyMs} ms")</span>
                    <span class="muted small">every @gc.IntervalSec s, down after @gc.FailureThreshold failures, last probe @Ago(gc.LastResultUtc)</span>
                    @if (!gc.Enabled) { <span class="muted">(disabled)</span> }
                    <text> · </text><a href="devices/@gateway.Id">history</a>
                }
            </p>
            <AuthorizeView Roles="Nms.Admin,Nms.Operator">
                <p class="small muted">@(string.IsNullOrEmpty(gateway.Address) ? "Set the public address and port" : "Change the address or port") in <a href="sites/@SiteId/settings">site settings</a>.</p>
            </AuthorizeView>
        </section>
    }

    <section class="card">
        <h3>Devices</h3>
        <AuthorizeView Roles="Nms.Admin,Nms.Operator">
            <div class="form-row">
                <input placeholder="Name" @bind="dev.Name" />
                <input placeholder="IP or hostname" @bind="dev.Address" />
                <input placeholder="MAC (optional)" @bind="dev.Mac" style="width:11em" />
                <input type="number" placeholder="VLAN" @bind="dev.VlanId" style="width:6em" />
                <input placeholder="tags, comma separated" @bind="dev.Tags" />
                <label><input type="checkbox" @bind="dev.IsCritical" /> critical</label>
                <button class="primary" @onclick="CreateDevice" disabled="@(string.IsNullOrWhiteSpace(dev.Name) || string.IsNullOrWhiteSpace(dev.Address))">Add device</button>
            </div>
            @if (error is not null) { <p class="error">@error</p> }
        </AuthorizeView>
        <table class="grid">
            <thead><tr><th>Device</th><th>Address</th><th>MAC</th><th>VLAN</th><th>Checks</th><th>Tags</th></tr></thead>
            <tbody>
            @foreach (var d in devices.Where(d => d.Kind == DeviceKind.Host).OrderBy(d => Worst(d)).ThenBy(d => d.Name))
            {
                <tr class="@(d.IsCritical ? "" : "muted")">
                    <td><a href="devices/@d.Id">@d.Name</a>@(d.IsCritical ? "" : " (non-critical)")</td>
                    <td>@d.Address</td>
                    <td class="small">@d.MacAddress</td>
                    <td>@d.VlanId</td>
                    <td>@foreach (var c in d.Checks) { <StateBadge State="c.State" Title="@CheckLabel(c)" /> }</td>
                    <td class="small">@string.Join(", ", d.Tags)</td>
                </tr>
            }
            </tbody>
        </table>
    </section>

    <AuthorizeView Roles="Nms.Admin,Nms.Operator">
        <details class="card" @ontoggle="LoadActivity">
            <summary>Recent changes at this site</summary>
            @if (activity is null) { <p class="muted small">Loading…</p> }
            else if (activity.Count == 0) { <p class="muted small">No changes recorded yet.</p> }
            else { <AuditTable Events="activity" /> <p class="small"><a href="audit">Full audit log</a></p> }
        </details>
    </AuthorizeView>
}

@code {
    private List<AuditEvent>? activity;
    private async Task LoadActivity() { activity ??= await Api.GetAuditAsync(SiteId, 20); }
    [Parameter] public Guid SiteId { get; set; }
    private Site? site;
    private List<Agent> agents = new();
    private List<Device> devices = new();
    private Device? gateway;
    private string newAgentName = "";
    private AgentCreated? token;
    private DeviceForm dev = new();
    private string? error;
    private Agent? discoveryAgent;
    private string discoveryCidr = "";
    private int? discoveryVlan;
    private bool discoveryRunning;
    private DiscoveryResult? discovery;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        await Live.EnsureConnectedAsync(SiteId);
        Live.Changed += OnChanged;
    }

    private async Task Load()
    {
        site = await Api.GetSiteAsync(SiteId);
        agents = await Api.GetAgentsAsync(SiteId);
        devices = await Api.GetDevicesAsync(SiteId);
        gateway = devices.FirstOrDefault(d => d.Kind == DeviceKind.Gateway);
    }
    private async Task OnChanged() { await Load(); await InvokeAsync(StateHasChanged); }
    public void Dispose() => Live.Changed -= OnChanged;

    private async Task CreateAgent() { token = await Api.CreateAgentAsync(SiteId, new AgentInput(newAgentName)); newAgentName = ""; agents = await Api.GetAgentsAsync(SiteId); }
    private async Task Reissue(Guid id) { token = await Api.ReissueTokenAsync(id); agents = await Api.GetAgentsAsync(SiteId); }
    private async Task Revoke(Guid id) { await Api.RevokeAgentAsync(id); agents = await Api.GetAgentsAsync(SiteId); }

    private void OpenDiscovery(Agent a)
    {
        discoveryAgent = a; discovery = null;
        var first = a.Interfaces.FirstOrDefault();
        if (first is not null) { discoveryCidr = $"{first.Address}/{first.PrefixLength}"; discoveryVlan = first.VlanId; }
    }
    private async Task RunDiscovery()
    {
        if (discoveryAgent is null) return;
        discoveryRunning = true; discovery = null; error = null;
        try
        {
            var id = await Api.StartDiscoveryAsync(discoveryAgent.Id, discoveryCidr, discoveryVlan);
            for (var i = 0; i < 60 && discovery is null; i++) { await Task.Delay(1000); discovery = await Api.GetDiscoveryAsync(id); }
            if (discovery is null) error = "Discovery timed out";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { discoveryRunning = false; }
    }
    private async Task AddDiscovered(DiscoveredHost h)
    {
        // Name the device after its hostname when DNS knows one (short label, since the site is implied); fall back to the address.
        var name = h.Hostname is null ? h.Address : h.Hostname.Split('.')[0];
        await Api.CreateDeviceAsync(SiteId, new DeviceInput(name, h.Address, discoveryVlan, true, [], null, h.MacAddress));
        devices = await Api.GetDevicesAsync(SiteId);
    }
    /// <summary>DHCP gave a known device (same MAC) a new address: keep its checks and history, change the address.</summary>
    private async Task MoveDevice(Device d, string address)
    {
        error = null;
        try
        {
            await Api.UpdateDeviceAsync(d.Id, new DeviceInput(d.Name, address, d.VlanId, d.IsCritical, d.Tags, d.Notes, d.MacAddress));
            devices = await Api.GetDevicesAsync(SiteId);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CreateDevice()
    {
        error = null;
        try
        {
            var tags = (dev.Tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            await Api.CreateDeviceAsync(SiteId, new DeviceInput(dev.Name, dev.Address, dev.VlanId, dev.IsCritical, tags, null, dev.Mac));
            dev = new(); devices = await Api.GetDevicesAsync(SiteId);
        }
        catch (ApiException ex) { error = ex.Message; }
    }

    private static int Worst(Device d) => d.Checks.Count == 0 ? 3 : d.Checks.Min(c => c.State switch { CheckState.Down => 0, CheckState.Degraded => 1, CheckState.Unknown => 2, _ => 3 });
    private static string CheckLabel(Check c) => c.Type + (c.Port is null ? "" : ":" + c.Port) + (c.LastLatencyMs is null ? "" : $" {c.LastLatencyMs} ms");
    private static string Ago(DateTimeOffset? t) => t is null ? "never" : (DateTimeOffset.UtcNow - t.Value) switch
    {
        { TotalSeconds: < 90 } s => $"{(int)s.TotalSeconds}s ago",
        { TotalMinutes: < 90 } s => $"{(int)s.TotalMinutes}m ago",
        { TotalHours: < 36 } s => $"{(int)s.TotalHours}h ago",
        var s => $"{(int)s.TotalDays}d ago",
    };

    private sealed class DeviceForm { public string Name { get; set; } = ""; public string Address { get; set; } = ""; public int? VlanId { get; set; } public string? Tags { get; set; } public bool IsCritical { get; set; } = true; public string? Mac { get; set; } }
}
