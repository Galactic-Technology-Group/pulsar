@page "/settings"
@attribute [Authorize(Roles = "Nms.Admin")]
@inject NmsApiClient Api

<PageTitle>Settings</PageTitle>
<h1>Settings</h1>

<section class="card">
    <h3>Notification channels</h3>
    <table class="grid">
        <thead><tr><th>Name</th><th>Type</th><th>Config</th><th>Enabled</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in channels)
        {
            <tr><td>@c.Name</td><td>@c.Type</td><td><code class="small">@Mask(c.ConfigJson)</code></td><td>@(c.Enabled ? "yes" : "no")</td>
                <td><button class="danger small" @onclick="() => DeleteChannel(c.Id)">Delete</button></td></tr>
        }
        </tbody>
    </table>
    <div class="form-row">
        <input placeholder="Name" @bind="ch.Name" />
        <select @bind="ch.Type">
            <option value="@NotificationChannelType.Email">Email</option>
            <option value="@NotificationChannelType.TeamsWebhook">Teams webhook</option>
        </select>
        <input placeholder="@(ch.Type == NotificationChannelType.Email ? "ops@example.com, noc@example.com" : "https://... webhook URL  or  secret:teams-webhook-ops")" @bind="ch.Value" style="min-width:28em" />
        <button class="primary" @onclick="CreateChannel" disabled="@(string.IsNullOrWhiteSpace(ch.Name) || string.IsNullOrWhiteSpace(ch.Value))">Add channel</button>
    </div>
</section>

<section class="card">
    <h3>Alert rules</h3>
    <table class="grid">
        <thead><tr><th>Name</th><th>Scope</th><th>Target</th><th>Channel</th><th>Critical only</th><th>Cooldown</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in rules)
        {
            <tr><td>@r.Name</td><td>@r.Scope</td><td>@(r.Scope switch { AlertScope.Site => siteNames.GetValueOrDefault(r.SiteId ?? Guid.Empty, "?"), AlertScope.Tag => r.Tag, AlertScope.Device => r.DeviceId?.ToString(), _ => "all" })</td>
                <td>@r.Channel?.Name</td><td>@(r.CriticalOnly ? "yes" : "no")</td><td>@r.CooldownSec s</td>
                <td><button class="danger small" @onclick="() => DeleteRule(r.Id)">Delete</button></td></tr>
        }
        </tbody>
    </table>
    <div class="form-row">
        <input placeholder="Name" @bind="rl.Name" />
        <select @bind="rl.Scope">
            <option value="@AlertScope.Global">All sites</option>
            <option value="@AlertScope.Site">One site</option>
            <option value="@AlertScope.Tag">Devices with tag</option>
        </select>
        @if (rl.Scope == AlertScope.Site)
        {
            <select @bind="rl.SiteId"><option value="">— site —</option>@foreach (var s in siteNames) { <option value="@s.Key">@s.Value</option> }</select>
        }
        @if (rl.Scope == AlertScope.Tag) { <input placeholder="tag" @bind="rl.Tag" /> }
        <select @bind="rl.ChannelId"><option value="">— channel —</option>@foreach (var c in channels) { <option value="@c.Id">@c.Name</option> }</select>
        <label><input type="checkbox" @bind="rl.CriticalOnly" /> critical only</label>
        <label>cooldown <input type="number" @bind="rl.CooldownSec" style="width:6em" /> s</label>
        <button class="primary" @onclick="CreateRule" disabled="@(string.IsNullOrWhiteSpace(rl.Name) || rl.ChannelId is null)">Add rule</button>
    </div>
</section>

<section class="card">
    <h3>Maintenance windows</h3>
    <table class="grid">
        <thead><tr><th>Scope</th><th>Start</th><th>End</th><th>Reason</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in maintenance)
        {
            <tr><td>@(m.DeviceId is not null ? $"device {m.DeviceId}" : m.SiteId is not null ? siteNames.GetValueOrDefault(m.SiteId.Value, "?") : "all")</td>
                <td>@m.StartUtc.ToLocalTime().ToString("g")</td><td>@m.EndUtc.ToLocalTime().ToString("g")</td><td>@m.Reason</td>
                <td><button class="danger small" @onclick="() => DeleteMaintenance(m.Id)">Delete</button></td></tr>
        }
        </tbody>
    </table>
    <div class="form-row">
        <select @bind="mw.SiteId"><option value="">all sites</option>@foreach (var s in siteNames) { <option value="@s.Key">@s.Value</option> }</select>
        <label>from <input type="datetime-local" @bind="mw.Start" /></label>
        <label>to <input type="datetime-local" @bind="mw.End" /></label>
        <input placeholder="reason" @bind="mw.Reason" />
        <button class="primary" @onclick="CreateMaintenance">Add window</button>
    </div>
</section>

<section class="card">
    <h3>Agent releases</h3>
    <table class="grid">
        <thead><tr><th>Version</th><th>Current</th><th>Published</th><th>x64</th><th>arm64</th></tr></thead>
        <tbody>@foreach (var r in releases) { <tr><td>@r.Version</td><td>@(r.IsCurrent ? "✓" : "")</td><td>@r.PublishedUtc.ToLocalTime().ToString("g")</td><td class="small">@r.DownloadUrlX64</td><td class="small">@r.DownloadUrlArm64</td></tr> }</tbody>
    </table>
    <div class="form-row">
        <input placeholder="version e.g. 0.2.0" @bind="rel.Version" style="width:9em" />
        <input placeholder="x64 download URL" @bind="rel.DownloadUrlX64" />
        <input placeholder="x64 sha256" @bind="rel.Sha256X64" />
        <input placeholder="arm64 download URL" @bind="rel.DownloadUrlArm64" />
        <input placeholder="arm64 sha256" @bind="rel.Sha256Arm64" />
        <button class="primary" @onclick="CreateRelease" disabled="@string.IsNullOrWhiteSpace(rel.Version)">Publish (agents update on next connect)</button>
    </div>
</section>
@if (error is not null) { <p class="error">@error</p> }

@code {
    private List<NotificationChannel> channels = new();
    private List<AlertRule> rules = new();
    private List<MaintenanceWindow> maintenance = new();
    private List<AgentRelease> releases = new();
    private Dictionary<Guid, string> siteNames = new();
    private string? error;
    private ChannelForm ch = new();
    private RuleForm rl = new();
    private MaintForm mw = new();
    private ReleaseForm rel = new();

    protected override async Task OnInitializedAsync()
    {
        siteNames = (await Api.GetSitesAsync()).ToDictionary(s => s.Id, s => s.Name);
        await Load();
    }
    private async Task Load()
    {
        channels = await Api.GetChannelsAsync(); rules = await Api.GetRulesAsync();
        maintenance = await Api.GetMaintenanceAsync(); releases = await Api.GetReleasesAsync();
    }

    private async Task Guard(Func<Task> f) { error = null; try { await f(); await Load(); } catch (Exception ex) { error = ex.Message; } }

    private Task CreateChannel() => Guard(async () =>
    {
        var json = ch.Type == NotificationChannelType.Email
            ? System.Text.Json.JsonSerializer.Serialize(new { to = ch.Value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) })
            : ch.Value.StartsWith("secret:") ? System.Text.Json.JsonSerializer.Serialize(new { secretName = ch.Value[7..] }) : System.Text.Json.JsonSerializer.Serialize(new { url = ch.Value });
        await Api.CreateChannelAsync(new ChannelInput(ch.Name, ch.Type, json)); ch = new();
    });
    private Task DeleteChannel(Guid id) => Guard(() => Api.DeleteChannelAsync(id));
    private Task CreateRule() => Guard(async () => { await Api.CreateRuleAsync(new RuleInput(rl.Name, rl.Scope, rl.ChannelId!.Value, rl.SiteId, null, rl.Tag, rl.CriticalOnly, rl.CooldownSec)); rl = new(); });
    private Task DeleteRule(Guid id) => Guard(() => Api.DeleteRuleAsync(id));
    private Task CreateMaintenance() => Guard(async () => { await Api.CreateMaintenanceAsync(new MaintenanceInput(mw.SiteId, null, new DateTimeOffset(mw.Start), new DateTimeOffset(mw.End), mw.Reason)); mw = new(); });
    private Task DeleteMaintenance(Guid id) => Guard(() => Api.DeleteMaintenanceAsync(id));
    private Task CreateRelease() => Guard(async () => { await Api.CreateReleaseAsync(new ReleaseInput(rel.Version, rel.DownloadUrlX64, rel.DownloadUrlArm64, rel.Sha256X64, rel.Sha256Arm64)); rel = new(); });

    private static string Mask(string json) => System.Text.RegularExpressions.Regex.Replace(json, "(https://[^\"]{12})[^\"]*", "$1…");

    private sealed class ChannelForm { public string Name { get; set; } = ""; public NotificationChannelType Type { get; set; } public string Value { get; set; } = ""; }
    private sealed class RuleForm { public string Name { get; set; } = ""; public AlertScope Scope { get; set; } public Guid? SiteId { get; set; } public string? Tag { get; set; } public Guid? ChannelId { get; set; } public bool CriticalOnly { get; set; } = true; public int CooldownSec { get; set; } = 300; }
    private sealed class MaintForm { public Guid? SiteId { get; set; } public DateTime Start { get; set; } = DateTime.Now; public DateTime End { get; set; } = DateTime.Now.AddHours(2); public string Reason { get; set; } = ""; }
    private sealed class ReleaseForm { public string Version { get; set; } = ""; public string DownloadUrlX64 { get; set; } = ""; public string DownloadUrlArm64 { get; set; } = ""; public string Sha256X64 { get; set; } = ""; public string Sha256Arm64 { get; set; } = ""; }
}
