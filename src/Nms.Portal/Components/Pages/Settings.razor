@page "/settings"
@attribute [Authorize(Roles = "Nms.Admin")]
@inject NmsApiClient Api

<PageTitle>App settings</PageTitle>
<h1>App settings</h1>
<p class="small muted">Settings here apply to every site. Each site's own credentials, alert rules, maintenance windows, gateway check and location are on its settings page, listed below.</p>

<section class="card">
    <h3>Site settings</h3>
    <table class="grid">
        <thead><tr><th>Site</th><th>SNMP credentials</th><th>Alert rules</th><th>Upcoming maintenance</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in siteNames.OrderBy(s => s.Value))
        {
            <tr><td><a href="sites/@s.Key">@s.Value</a></td>
                <td>@siteCreds.GetValueOrDefault(s.Key)</td><td>@siteRules.GetValueOrDefault(s.Key)</td><td>@siteWindows.GetValueOrDefault(s.Key)</td>
                <td><a href="sites/@s.Key/settings">Settings</a></td></tr>
        }
        @if (siteNames.Count == 0) { <tr><td colspan="5" class="muted small">No sites yet. Add one under <a href="sites">Sites</a>.</td></tr> }
        </tbody>
    </table>
</section>

<section class="card">
    <h3>Notification channels</h3>
    <table class="grid">
        <thead><tr><th>Name</th><th>Type</th><th>Config</th><th>Enabled</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in channels)
        {
            <tr><td>@c.Name</td><td>@c.Type</td><td><code class="small">@Mask(c.ConfigJson)</code></td><td>@(c.Enabled ? "yes" : "no")</td>
                <td><button class="danger small" @onclick="() => DeleteChannel(c.Id)">Delete</button></td></tr>
        }
        </tbody>
    </table>
    <div class="form-row">
        <input placeholder="Name" @bind="ch.Name" />
        <select @bind="ch.Type">
            <option value="@NotificationChannelType.Email">Email</option>
            <option value="@NotificationChannelType.TeamsWebhook">Teams webhook</option>
        </select>
        <input placeholder="@(ch.Type == NotificationChannelType.Email ? "ops@example.com, noc@example.com" : "https://... webhook URL  or  secret:teams-webhook-ops")" @bind="ch.Value" style="min-width:28em" />
        <button class="primary" @onclick="CreateChannel" disabled="@(string.IsNullOrWhiteSpace(ch.Name) || string.IsNullOrWhiteSpace(ch.Value))">Add channel</button>
    </div>
</section>

<AlertRulesEditor SiteNames="siteNames" @key="channelsVersion" />

<MaintenanceEditor />

<SnmpCredentialsEditor />

<section class="card">
    <h3>Agent releases</h3>
    <table class="grid">
        <thead><tr><th>Version</th><th>Current</th><th>Rolled back</th><th>Published</th><th>x64</th><th>arm64</th></tr></thead>
        <tbody>@foreach (var r in releases) { <tr><td>@r.Version</td><td>@(r.IsCurrent ? "✓" : "")</td><td>@if (r.RolledBackAgents > 0) { <span class="error">@r.RolledBackAgents agent(s)</span> }</td><td>@r.PublishedUtc.ToLocalTime().ToString("g")</td><td class="small">@r.DownloadUrlX64</td><td class="small">@r.DownloadUrlArm64</td></tr> }</tbody>
    </table>
    <p class="small">Publishing makes a version current: connected agents download it immediately, agents that are offline pick it up at their next heartbeat. Each agent verifies the SHA-256, swaps its binary and restarts under systemd. An agent that crash-loops on the new version, or cannot reach the hub within 10 minutes while the API answers, restores its previous binary, blocks that version and shows up under <em>Rolled back</em>; publish a fixed release to move it on.</p>
    <div class="form-row">
        <input placeholder="GitHub tag, e.g. v0.1.3 (blank = latest)" @bind="importTag" style="width:18em" />
        <button class="primary" @onclick="ImportRelease" disabled="@importing">@(importing ? "Publishing…" : "Publish from GitHub release")</button>
    </div>
    <details>
        <summary class="small">Publish a build hosted elsewhere</summary>
    <div class="form-row">
        <input placeholder="version e.g. 0.2.0" @bind="rel.Version" style="width:9em" />
        <input placeholder="x64 download URL" @bind="rel.DownloadUrlX64" />
        <input placeholder="x64 sha256" @bind="rel.Sha256X64" />
        <input placeholder="arm64 download URL" @bind="rel.DownloadUrlArm64" />
        <input placeholder="arm64 sha256" @bind="rel.Sha256Arm64" />
        <button class="primary" @onclick="CreateRelease" disabled="@string.IsNullOrWhiteSpace(rel.Version)">Publish</button>
    </div>
    </details>
</section>
@if (error is not null) { <p class="error">@error</p> }

@code {
    private List<NotificationChannel> channels = new();
    private List<AgentRelease> releases = new();
    private Dictionary<Guid, string> siteNames = new();
    private Dictionary<Guid, int> siteCreds = new(), siteRules = new(), siteWindows = new();
    private int channelsVersion;   // re-creates the rules editor so its channel list follows changes made here
    private string? error;
    private ChannelForm ch = new();
    private ReleaseForm rel = new();
    private string importTag = "";
    private bool importing;

    protected override async Task OnInitializedAsync()
    {
        siteNames = (await Api.GetSitesAsync()).ToDictionary(s => s.Id, s => s.Name);
        await Load();
    }
    private async Task Load()
    {
        channels = await Api.GetChannelsAsync(); releases = await Api.GetReleasesAsync();
        siteCreds = Count((await Api.GetSnmpCredentialsAsync()).Select(c => c.SiteId));
        siteRules = Count((await Api.GetRulesAsync()).Where(r => r.Scope == AlertScope.Site).Select(r => r.SiteId));
        siteWindows = Count((await Api.GetMaintenanceAsync()).Where(m => m.EndUtc > DateTimeOffset.UtcNow).Select(m => m.SiteId));
    }
    private static Dictionary<Guid, int> Count(IEnumerable<Guid?> ids) =>
        ids.Where(i => i is not null).GroupBy(i => i!.Value).ToDictionary(g => g.Key, g => g.Count());

    private async Task Guard(Func<Task> f) { error = null; try { await f(); await Load(); } catch (Exception ex) { error = ex.Message; } }

    private Task CreateChannel() => Guard(async () =>
    {
        var json = ch.Type == NotificationChannelType.Email
            ? System.Text.Json.JsonSerializer.Serialize(new { to = ch.Value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) })
            : ch.Value.StartsWith("secret:") ? System.Text.Json.JsonSerializer.Serialize(new { secretName = ch.Value[7..] }) : System.Text.Json.JsonSerializer.Serialize(new { url = ch.Value });
        await Api.CreateChannelAsync(new ChannelInput(ch.Name, ch.Type, json)); ch = new(); channelsVersion++;
    });
    private Task DeleteChannel(Guid id) => Guard(async () => { await Api.DeleteChannelAsync(id); channelsVersion++; });
    private Task CreateRelease() => Guard(async () => { await Api.CreateReleaseAsync(new ReleaseInput(rel.Version, rel.DownloadUrlX64, rel.DownloadUrlArm64, rel.Sha256X64, rel.Sha256Arm64)); rel = new(); });
    private async Task ImportRelease()
    {
        importing = true;
        try { await Guard(async () => { await Api.ImportReleaseAsync(string.IsNullOrWhiteSpace(importTag) ? null : importTag.Trim()); importTag = ""; }); }
        finally { importing = false; }
    }

    private static string Mask(string json) => System.Text.RegularExpressions.Regex.Replace(json, "(https://[^\"]{12})[^\"]*", "$1…");

    private sealed class ChannelForm { public string Name { get; set; } = ""; public NotificationChannelType Type { get; set; } public string Value { get; set; } = ""; }
    private sealed class ReleaseForm { public string Version { get; set; } = ""; public string DownloadUrlX64 { get; set; } = ""; public string DownloadUrlArm64 { get; set; } = ""; public string Sha256X64 { get; set; } = ""; public string Sha256Arm64 { get; set; } = ""; }
}
